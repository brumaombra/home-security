{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Video Analysis App",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "start"
            ],
            "cwd": "${workspaceFolder}/video-analysis",
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug User Dashboard App",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}/user-dashboard",
            "console": "integratedTerminal"
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Debug Python Inference Server",
            "module": "uvicorn",
            "args": [
                "app:app --host 0.0.0.0 --port 3002"
            ],
            "cwd": "${workspaceFolder}/python-inference-server",
            "console": "integratedTerminal"
        }
    ]
}